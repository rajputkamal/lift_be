# Add these to the deployment environment or untracked .env; never commit real values.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DB
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_MODE_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_TEST_WEBHOOK_SECRET
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000
# Set true only for cross-site HTTPS frontend/API deployments.
GUEST_COOKIE_CROSS_SITE=false
NODE_ENV=development
