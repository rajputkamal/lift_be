# Add these to the deployment environment or untracked .env; never commit real values.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DB
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_MODE_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_TEST_WEBHOOK_SECRET
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,https://YOUR_FRONTEND_DOMAIN
# Set true when the browser frontend and HTTPS API are on different sites,
# including http://localhost:3000 calling an HTTPS Cloud Run API.
GUEST_COOKIE_CROSS_SITE=false
NODE_ENV=development
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@mwxiqdif
