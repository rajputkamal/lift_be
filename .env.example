# Micro Greens Kart backend only. Copy to .env and supply private values.
# The existing Lift/Foodie .env must not be replaced by this example.
SERVICE_MODE=microgreens
MICROGREENS_ENVIRONMENT=test
NODE_ENV=development
PORT=8080
MICROGREENS_API_PREFIX=/v1
# Test requires /rides; production requires /microgreenskart. Replica set required.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/rides
PUBLIC_API_URL=http://localhost:8080/v1
FRONTEND_URL=http://localhost:3000
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MICROGREENS_CATALOGUE_WRITES=disabled
# Firebase Hosting requires __session; direct local APIs can also use grower_guest.
GUEST_COOKIE_NAME=__session
# true for localhost frontend calling an HTTPS test backend; false for local HTTP.
GUEST_COOKIE_CROSS_SITE=false

# Razorpay TEST keys only; keep mode unchanged in both environments.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional catalogue uploads; never expose this credential to the browser.
CLOUDINARY_URL=

# Resend handles order confirmations only. HubSpot retains CRM and enquiries.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
# Generate a separate private token for each environment: openssl rand -hex 32
EMAIL_WORKER_TOKEN=
ORDER_EMAIL_FROM="Micro Greens Kart <orders@microgreenskart.in>"
ORDER_EMAIL_REPLY_TO=orders@microgreenskart.in
# Test sends only to these comma-separated addresses; no recipient redirection.
EMAIL_TEST_RECIPIENT_ALLOWLIST=rajput.kamal40@gmail.com
